[desktop entry]
type=application
name=brahma
GenericName=image editor
comment=edit photos and layered PSD documents
exec=brahma %f
TryExec=brahma
icon=com.houseofasher.brahma
terminal=false
# the native runner does not complete desktop startup-notification handshakes.
StartupNotify=false
startupwmclass=com.houseofasher.brahma
categories=graphics;2dgraphics;RasterGraphics;photography;
keywords=photo;image;editor;psd;layers;retouch;paint;
MimeType=application/x-brahma;image/x-paintnet;image/openraster;application/x-krita;image/vnd.adobe.photoshop;image/x-psd;image/x-psb;image/png;image/jpeg;image/tiff;image/webp;image/gif;image/bmp;image/x-tga;image/x-icon;image/vnd.microsoft.icon;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-exr;image/vnd.radiance;image/avif;image/qoi;
# AppRun registers the desktop entry and icons itself (#593); tell external
# AppImage integrators (AppImageLauncher, appimaged) not to add a duplicate (#3623).
x-AppImage-integrate=false
